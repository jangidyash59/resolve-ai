# Node/Express API Gateway Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/resolveai
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/resolveai

# AI Service URL
AI_SERVICE_URL=http://localhost:8000
# For production: https://your-ai-service.render.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
# For production: https://your-frontend.vercel.app

# Optional: JWT Secret (if you add authentication)
# JWT_SECRET=your-secret-key-here
